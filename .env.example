# Copy to .env (install.ps1 does this for you). launch.bat reads it.
# Everything is optional.

# Port for the local app.
AUTOCLIP_PORT=8765

# Where videos, the database, settings and exported clips live.
# Default: %USERPROFILE%\.autoclip
# AUTOCLIP_HOME=D:\autoclip-data

# Optional cloud providers, only for the optional "refine titles" step. NEVER commit real keys.
# Prefer:  autoclip config set-secret anthropic   (stores the key in the Windows Credential Manager)
# ANTHROPIC_API_KEY=
